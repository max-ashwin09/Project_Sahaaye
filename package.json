{
  "name": "sahaaye-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SAHAAYE - Community Humanitarian Aid Platform",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix shared run build && npm --prefix backend run build && npm --prefix frontend run build && node -e \"const fs = require('fs'); fs.cpSync('frontend/dist', 'dist', { recursive: true });\"",
    "build:android": "cd android && JAVA_HOME=\"$HOME/.jdk17/Contents/Home\" ./gradlew assembleDebug",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:security": "npm --prefix backend run test:security",
    "test:moderation": "jest tests/security/abuse/moderation.test.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "audit:security": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "supertest": "^7.3.1",
    "typescript": "^5.4.0"
  }
}
