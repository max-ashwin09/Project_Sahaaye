# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:3000

# Security & JWT Secrets
JWT_SECRET=replace_this_with_a_64_character_cryptographically_secure_random_string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=replace_this_with_another_64_char_secure_random_string
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace_this_cookie_secret_key

# Database Connection (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://sahaaye_user:sahaaye_password@localhost:5432/sahaaye_db

# Redis (Job Queue & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Media Storage (S3 / MinIO / Local)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=sahaaye-media

# Internal AI Services
AI_SERVICE_URL=http://ai-services:8000
AI_INTERNAL_SECRET=replace_internal_shared_secret

# Privacy & Legal Compliance (DPDP Act)
GRIEVANCE_OFFICER_NAME="Grievance Officer SAHAAYE"
GRIEVANCE_OFFICER_EMAIL="grievance@sahaaye.org"
DATA_RETENTION_DAYS_RESOLVED_NEEDS=90
DATA_RETENTION_DAYS_UNPUBLISHED_MEDIA=7
