{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@sahaaye/shared": ["./shared/index.ts"],
      "@sahaaye/shared/*": ["./shared/*"]
    }
  },
  "include": ["backend/src/**/*", "shared/**/*", "tests/**/*"]
}
